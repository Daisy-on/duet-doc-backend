APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_QUALITY_MODEL=deepseek-v4-pro

AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=120
AI_MAX_MESSAGES=50
AI_MAX_CONTEXT_CHARS=50000

# 云端 BGE 文本索引及用户单独同意的图片描述索引，由独立 Worker 调用。
DASHSCOPE_API_KEY=
RAG_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
RAG_VISION_MODEL=qwen3-vl-flash
SILICONFLOW_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
RAG_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_EMBEDDING_DIMENSION=1024
RAG_WORKER_POLL_SECONDS=2
RAG_WORKER_MAX_ATTEMPTS=3

# 私有 OSS 模型下载。生产环境通过绑定到 ECS 的 RAM Role 获取临时凭证。
OSS_REGION=cn-chengdu
OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
OSS_BUCKET=
OSS_ECS_ROLE_NAME=DuetDocModelReaderRole
OSS_MEDIA_BUCKET=
MEDIA_MAX_SIZE_BYTES=10485760
MEDIA_URL_TTL_SECONDS=900
MODEL_DOWNLOAD_URL_TTL_SECONDS=900
MODEL_MANIFEST_USER_HOURLY_LIMIT=3
MODEL_MANIFEST_USER_DAILY_LIMIT=8
MODEL_MANIFEST_CACHE_SAFETY_SECONDS=30
MODEL_MANIFEST_IP_RATE_PER_MINUTE=5
MODEL_MANIFEST_IP_BURST=3

# 仅当 API 只允许由受控反向代理访问时启用。
TRUST_PROXY_HEADERS=false
AUTH_REGISTER_IP_LIMIT_PER_HOUR=5
AUTH_LOGIN_IP_LIMIT_PER_MINUTE=10

POSTGRES_DB=duet_doc
POSTGRES_USER=duet_doc
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://duet_doc:change_me@127.0.0.1:5433/duet_doc
DEV_AUTH_ENABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# 生产环境请使用至少 32 字节的随机值，且不要提交真实密钥。
AUTH_JWT_SECRET=development-only-change-me-32-bytes
AUTH_JWT_ISSUER=duet-doc-backend
AUTH_JWT_AUDIENCE=duet-doc-app
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_REFRESH_COOKIE_NAME=duet_refresh_token
